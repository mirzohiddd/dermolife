# Server
PORT=5000
NODE_ENV=development

# Telegram Bot API
# 1. Create a bot with @BotFather and copy the token below.
# 2. Add the bot to your group and grant it permission to send messages
#    (it must be an admin, or the group must allow bots to post).
# 3. Get the numeric group chat id (e.g. via @userinfobot or the
#    getUpdates API) and paste it below. Group chat ids are usually negative.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_CHAT_ID=-1001234567890

# Comma-separated list of frontend origins allowed to call this API.
# Add each landing's dev and production URL.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
